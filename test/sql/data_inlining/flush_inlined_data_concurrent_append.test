# name: test/sql/data_inlining/flush_inlined_data_concurrent_append.test
# description: A flush of inlined data inside a transaction, with an append committing meanwhile, rolls back cleanly
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/flush_concurrent_append', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1), (2), (3)

statement ok con1
BEGIN

# the flush writes to the metadata catalog before the transaction commits
query III con1
SELECT schema_name, table_name, rows_flushed FROM ducklake_flush_inlined_data('lake')
----
main	t	3

# a newer append lands in the inlined table meanwhile
statement ok con2
INSERT INTO lake.t VALUES (4)

statement ok con1
ROLLBACK

# the flush is undone and the newer row is untouched
query I
SELECT COUNT(*) FROM lake.t
----
4

query I
SELECT COUNT(*) FROM __ducklake_metadata_lake.ducklake_inlined_data_1_1
----
4

query III
SELECT schema_name, table_name, rows_flushed FROM ducklake_flush_inlined_data('lake')
----
main	t	4

query II
SELECT COUNT(*), SUM(i) FROM lake.t
----
4	10
