# name: test/sql/compaction/sort_data_files.test
# description: ducklake_sort_data_files rewrites each partition into files ordered by the sort key
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/sort_data_files', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

# file ranges of the sort key of the live files of a table, and how many overlap a lower range
statement ok
CREATE MACRO memory.file_ranges(tbl, col) AS TABLE
WITH f AS (
	SELECT s.min_value AS lo, s.max_value AS hi
	FROM __ducklake_metadata_ducklake.ducklake_data_file d
	JOIN __ducklake_metadata_ducklake.ducklake_file_column_stats s USING (data_file_id)
	JOIN __ducklake_metadata_ducklake.ducklake_column c
		ON c.table_id = s.table_id AND c.column_id = s.column_id AND c.end_snapshot IS NULL
	JOIN __ducklake_metadata_ducklake.ducklake_table t ON t.table_id = d.table_id AND t.end_snapshot IS NULL
	WHERE d.end_snapshot IS NULL AND t.table_name = tbl AND c.column_name = col
)
SELECT count(*) AS file_count, count(*) FILTER (WHERE lo < prev_hi) AS overlap_count
FROM (SELECT *, lag(hi) OVER (ORDER BY lo, hi) AS prev_hi FROM f)

# a table without a sort has nothing to sort
statement ok
CREATE TABLE unsorted (k VARCHAR, v BIGINT)

statement ok
INSERT INTO unsorted SELECT 'k' || (i % 10), i FROM range(100) t(i)

statement ok
INSERT INTO unsorted SELECT 'k' || (i % 10), i FROM range(100) t(i)

query I
SELECT count(*) FROM ducklake_sort_data_files('ducklake', 'unsorted')
----
0

# every insert holds every key, so the files of the table overlap
statement ok
CREATE TABLE t (k VARCHAR, ts BIGINT, v DOUBLE)

statement ok
ALTER TABLE t SET SORTED BY (k, ts)

statement ok
CALL ducklake.set_option('parquet_row_group_size', '1024', table_name => 't')

statement ok
INSERT INTO t SELECT 'k' || lpad((i * 7919 % 200)::VARCHAR, 3, '0'), i, i FROM range(20000) r(i)

statement ok
INSERT INTO t SELECT 'k' || lpad((i * 7919 % 200)::VARCHAR, 3, '0'), i + 20000, i FROM range(20000) r(i)

statement ok
INSERT INTO t SELECT 'k' || lpad((i * 7919 % 200)::VARCHAR, 3, '0'), i + 40000, i FROM range(20000) r(i)

statement ok
INSERT INTO t SELECT 'k' || lpad((i * 7919 % 200)::VARCHAR, 3, '0'), i + 60000, i FROM range(20000) r(i)

query II
SELECT * FROM memory.file_ranges('t', 'k')
----
4	3

query III
SELECT count(*), sum(v), count(DISTINCT k) FROM t
----
80000	799960000.0	200

statement ok
SET VARIABLE before_sort = (SELECT max(snapshot_id) FROM ducklake_snapshots('ducklake'))

# small files, so the sort is split into slices by key range and each slice into files
statement ok
SET ducklake_target_file_size = '100KB'

query IIII
SELECT schema_name, table_name, files_processed, files_created > 1 FROM ducklake_sort_data_files('ducklake', 't')
----
main	t	4	true

query II
SELECT file_count > 1, overlap_count FROM memory.file_ranges('t', 'k')
----
true	0

query III
SELECT count(*), sum(v), count(DISTINCT k) FROM t
----
80000	799960000.0	200

query III
SELECT count(*), sum(v), count(DISTINCT k) FROM t AT (VERSION => getvariable('before_sort'))
----
80000	799960000.0	200

# the rows of every file are in key order
statement ok
SET VARIABLE t_files = (SELECT list(data_file) FROM ducklake_list_files('ducklake', 't'))

query I
SELECT count(*) FROM (
	SELECT k, ts, lag(k) OVER w AS pk, lag(ts) OVER w AS pts
	FROM read_parquet(getvariable('t_files'), filename = true, file_row_number = true)
	WINDOW w AS (PARTITION BY filename ORDER BY file_row_number)
) WHERE k < pk OR (k = pk AND ts < pts)
----
0

# a sorted partition is left alone
query I
SELECT count(*) FROM ducklake_sort_data_files('ducklake', 't')
----
0

# a new file overlaps the sorted files again
statement ok
INSERT INTO t SELECT 'k' || lpad((i * 7919 % 200)::VARCHAR, 3, '0'), i + 80000, i FROM range(2000) r(i)

query I
SELECT overlap_count > 0 FROM memory.file_ranges('t', 'k')
----
true

query I
SELECT files_processed > 1 FROM ducklake_sort_data_files('ducklake', 't')
----
true

query II
SELECT file_count > 1, overlap_count FROM memory.file_ranges('t', 'k')
----
true	0

query II
SELECT count(*), sum(v) FROM t
----
82000	801959000.0

# a descending key with NULLs first
statement ok
CREATE TABLE d (k VARCHAR, v BIGINT)

statement ok
ALTER TABLE d SET SORTED BY (k DESC NULLS FIRST)

statement ok
CALL ducklake.set_option('parquet_row_group_size', '1024', table_name => 'd')

statement ok
INSERT INTO d SELECT CASE WHEN i % 50 = 0 THEN NULL ELSE 'k' || lpad((i % 300)::VARCHAR, 3, '0') END, i FROM range(15000) r(i)

statement ok
INSERT INTO d SELECT CASE WHEN i % 50 = 0 THEN NULL ELSE 'k' || lpad((i % 300)::VARCHAR, 3, '0') END, i FROM range(15000) r(i)

statement ok
INSERT INTO d SELECT CASE WHEN i % 50 = 0 THEN NULL ELSE 'k' || lpad((i % 300)::VARCHAR, 3, '0') END, i FROM range(15000) r(i)

statement ok
SET ducklake_target_file_size = '60KB'

query I
SELECT files_processed FROM ducklake_sort_data_files('ducklake', 'd')
----
3

query II
SELECT file_count > 1, overlap_count FROM memory.file_ranges('d', 'k')
----
true	0

query III
SELECT count(*), count(k), sum(v) FROM d
----
45000	44100	337477500

# partitions are sorted one by one
statement ok
CREATE TABLE p (part INTEGER, k VARCHAR, v BIGINT)

statement ok
ALTER TABLE p SET PARTITIONED BY (part)

statement ok
ALTER TABLE p SET SORTED BY (k)

statement ok
INSERT INTO p SELECT i % 2, 'k' || lpad((i * 31 % 100)::VARCHAR, 3, '0'), i FROM range(4000) r(i)

statement ok
INSERT INTO p SELECT i % 2, 'k' || lpad((i * 31 % 100)::VARCHAR, 3, '0'), i FROM range(4000) r(i)

statement ok
SET ducklake_target_file_size = '512MB'

query I
SELECT files_processed FROM ducklake_sort_data_files('ducklake', 'p') ORDER BY ALL
----
2
2

query I
SELECT count(*) FROM ducklake_list_files('ducklake', 'p')
----
2

query II
SELECT count(*), sum(v) FROM p
----
8000	15996000

# ranges of the second sort key over the live files that hold one value of the first, and how many overlap
statement ok
CREATE MACRO memory.second_key_ranges(tbl, first_col, first_value, col) AS TABLE
WITH f AS (
	SELECT s2.min_value AS lo, s2.max_value AS hi
	FROM __ducklake_metadata_ducklake.ducklake_data_file d
	JOIN __ducklake_metadata_ducklake.ducklake_table t ON t.table_id = d.table_id AND t.end_snapshot IS NULL
	JOIN __ducklake_metadata_ducklake.ducklake_column c1
		ON c1.table_id = d.table_id AND c1.end_snapshot IS NULL AND c1.column_name = first_col
	JOIN __ducklake_metadata_ducklake.ducklake_file_column_stats s1
		ON s1.data_file_id = d.data_file_id AND s1.column_id = c1.column_id
	JOIN __ducklake_metadata_ducklake.ducklake_column c2
		ON c2.table_id = d.table_id AND c2.end_snapshot IS NULL AND c2.column_name = col
	JOIN __ducklake_metadata_ducklake.ducklake_file_column_stats s2
		ON s2.data_file_id = d.data_file_id AND s2.column_id = c2.column_id
	WHERE d.end_snapshot IS NULL AND t.table_name = tbl AND s1.min_value = first_value AND s1.max_value = first_value
)
SELECT count(*) AS file_count, count(*) FILTER (WHERE lo < prev_hi) AS overlap_count
FROM (SELECT *, lag(hi) OVER (ORDER BY lo, hi) AS prev_hi FROM f)

# one first key value holds most rows, so the sort splits it by the second key; NULL second keys sort last
statement ok
CREATE TABLE s (k VARCHAR, p VARCHAR, v BIGINT)

statement ok
ALTER TABLE s SET SORTED BY (k, p)

# NULL second keys sort first
statement ok
CREATE TABLE sn (k VARCHAR, p VARCHAR, v BIGINT)

statement ok
ALTER TABLE sn SET SORTED BY (k, p NULLS FIRST)

foreach tbl s sn

statement ok
CALL ducklake.set_option('parquet_row_group_size', '1024', table_name => '{tbl}')

loop j 0 3

statement ok
INSERT INTO {tbl} SELECT CASE WHEN i % 10 = 0 THEN 'a' || (i % 7) ELSE 'big' END,
	CASE WHEN i % 97 = 0 THEN NULL ELSE 'p' || lpad((i * 31 % 500)::VARCHAR, 3, '0') END, i + {j} * 20000
FROM range(20000) r(i)

endloop

statement ok
SET ducklake_target_file_size = '100KB'

query I
SELECT files_processed FROM ducklake_sort_data_files('ducklake', '{tbl}')
----
3

query II
SELECT file_count > 1, overlap_count FROM memory.second_key_ranges('{tbl}', 'k', 'big', 'p')
----
true	0

query II
SELECT file_count > 1, overlap_count FROM memory.file_ranges('{tbl}', 'k')
----
true	0

query IIII
SELECT count(*), count(p), sum(v), count(*) FILTER (WHERE k = 'big' AND p IS NULL) FROM {tbl}
----
60000	59379	1799970000	558

statement ok
SET VARIABLE s_files = (SELECT list(data_file) FROM ducklake_list_files('ducklake', '{tbl}'))

query I
SELECT count(*) FROM (
	SELECT k, p, lag(k) OVER w AS pk, lag(p) OVER w AS pp
	FROM read_parquet(getvariable('s_files'), filename = true, file_row_number = true)
	WINDOW w AS (PARTITION BY filename ORDER BY file_row_number)
) WHERE k < pk OR (k = pk AND ('{tbl}' = 's' AND (p < pp OR (p IS NOT NULL AND pp IS NULL)) OR '{tbl}' = 'sn' AND (p < pp OR (p IS NULL AND pp IS NOT NULL))))
----
0

endloop

# a first key value whose second key is mostly NULL holds most rows, so the sort splits it by the third key, an
# expression; with one file per slice, the files of that group hold disjoint ranges of the third key
statement ok
CREATE TABLE h (k VARCHAR, p VARCHAR, r BIGINT, ts BIGINT)

statement ok
ALTER TABLE h SET SORTED BY (k, p, hash(r), ts)

statement ok
CREATE TABLE hn (k VARCHAR, p VARCHAR, r BIGINT, ts BIGINT)

statement ok
ALTER TABLE hn SET SORTED BY (k, p NULLS FIRST, hash(r), ts)

foreach tbl h hn

statement ok
CALL ducklake.set_option('parquet_row_group_size', '1024', table_name => '{tbl}')

loop j 0 3

statement ok
INSERT INTO {tbl} SELECT CASE WHEN i % 10 = 0 THEN 'a' || (i % 7) ELSE 'big' END,
	CASE WHEN i % 10 = 0 OR i % 5 = 0 THEN 'p' || (i % 3) END, i * 7919 % 1000, i + {j} * 20000
FROM range(20000) r(i)

endloop

query II
SELECT files_processed, files_created > 3 FROM ducklake_sort_data_files('ducklake', '{tbl}', max_slice_size => 20000, single_writer => false)
----
3	true

statement ok
SET VARIABLE h_files = (SELECT list(data_file) FROM ducklake_list_files('ducklake', '{tbl}'))

query II
WITH f AS (
	SELECT filename, min(hash(r)) AS lo, max(hash(r)) AS hi
	FROM read_parquet(getvariable('h_files'), filename = true)
	WHERE k = 'big' AND p IS NULL
	GROUP BY filename
)
SELECT count(*) > 1, count(*) FILTER (WHERE lo <= prev_hi) FROM (SELECT *, lag(hi) OVER (ORDER BY lo, hi) AS prev_hi FROM f)
----
true	0

query IIII
SELECT count(*), count(p), sum(ts), count(*) FILTER (WHERE k = 'big' AND p IS NULL) FROM {tbl}
----
60000	12000	1799970000	48000

query I
SELECT count(*) FROM (
	SELECT k, p, hash(r) AS h, ts, lag(k) OVER w AS pk, lag(p) OVER w AS pp, lag(hash(r)) OVER w AS ph, lag(ts) OVER w AS pts
	FROM read_parquet(getvariable('h_files'), filename = true, file_row_number = true)
	WINDOW w AS (PARTITION BY filename ORDER BY file_row_number)
) WHERE k < pk
	OR (k = pk AND ('{tbl}' = 'h' AND (p < pp OR (p IS NOT NULL AND pp IS NULL)) OR '{tbl}' = 'hn' AND (p < pp OR (p IS NULL AND pp IS NOT NULL))))
	OR (k = pk AND p IS NOT DISTINCT FROM pp AND (h < ph OR (h = ph AND ts < pts)))
----
0

endloop

# one writer for all slices starts a new file at the target size, however small the slices are, and without it every
# slice writes its own file
foreach sw true false

statement ok
CREATE TABLE w_{sw} (k VARCHAR, ts BIGINT, v DOUBLE)

statement ok
ALTER TABLE w_{sw} SET SORTED BY (k, ts)

statement ok
CALL ducklake.set_option('parquet_row_group_size', '1024', table_name => 'w_{sw}')

loop j 0 4

statement ok
INSERT INTO w_{sw} SELECT 'k' || lpad((i * 7919 % 200)::VARCHAR, 3, '0'), i + {j} * 20000, i FROM range(20000) r(i)

endloop

statement ok
SET ducklake_target_file_size = '100KB'

query II
SELECT files_processed > 1, files_created > 1 FROM ducklake_sort_data_files('ducklake', 'w_{sw}', max_slice_size => 20000, single_writer => {sw})
----
true	true

query II
SELECT file_count > 1, overlap_count FROM memory.file_ranges('w_{sw}', 'k')
----
true	0

statement ok
SET VARIABLE w_files = (SELECT list(data_file) FROM ducklake_list_files('ducklake', 'w_{sw}'))

query I
SELECT count(*) FROM (
	SELECT k, ts, lag(k) OVER win AS pk, lag(ts) OVER win AS pts
	FROM read_parquet(getvariable('w_files'), filename = true, file_row_number = true)
	WINDOW win AS (PARTITION BY filename ORDER BY file_row_number)
) WHERE k < pk OR (k = pk AND ts < pts)
----
0

query III
SELECT count(*), sum(v), count(DISTINCT k) FROM w_{sw}
----
80000	799960000.0	200

endloop

