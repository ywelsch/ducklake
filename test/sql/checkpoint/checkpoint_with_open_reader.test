# name: test/sql/checkpoint/checkpoint_with_open_reader.test
# description: The metadata catalog can be checkpointed while another DuckLake transaction is open
# group: [checkpoint]

require ducklake

require parquet

# the checkpoint below is of a DuckDB metadata catalog
test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/checkpoint_with_open_reader')

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1)

# a long-running DuckLake transaction that has read the metadata
statement ok con1
BEGIN

query I con1
SELECT COUNT(*) FROM lake.t
----
1

# an append commits meanwhile: its commit updates the table statistics in the metadata catalog
statement ok con2
INSERT INTO lake.t VALUES (2)

# the reader's DuckLake transaction does not hold a transaction on the metadata catalog, so the committed update is
# cleaned up right away and the metadata catalog can be checkpointed
statement ok
CHECKPOINT __ducklake_metadata_lake

query I con1
SELECT COUNT(*) FROM lake.t
----
1

statement ok con1
COMMIT

query I
SELECT COUNT(*) FROM lake.t
----
2
