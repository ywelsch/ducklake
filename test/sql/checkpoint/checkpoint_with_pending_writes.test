# name: test/sql/checkpoint/checkpoint_with_pending_writes.test
# description: The metadata catalog can be checkpointed while a DuckLake transaction has unflushed writes
# group: [checkpoint]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/checkpoint_with_pending_writes', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1)

# a writer with data written but not committed
statement ok con1
BEGIN

statement ok con1
INSERT INTO lake.t SELECT range FROM range(100, 200)

query I con1
SELECT COUNT(*) FROM lake.t
----
101

# another appender to the same table commits meanwhile: its commit updates the stats row
statement ok con2
INSERT INTO lake.t SELECT range FROM range(200, 250)

statement ok
CHECKPOINT __ducklake_metadata_lake

# the writer's commit runs after the checkpoint, against the stats row the other appender updated
statement ok con1
COMMIT

query II
SELECT COUNT(*), SUM(i) FROM lake.t
----
151	26176
